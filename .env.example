# Group sync (optional). Copy to .env and fill in from Supabase → Project Settings → API.
# Without these the app runs fully on-device and shows groups as "on this device only".
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Workout photo reading (optional). The website uses its own /api/analyze automatically.
# The phone app (Expo Go / builds) needs the full URL of a deployed site:
# EXPO_PUBLIC_ANALYZE_URL=https://form-fitness-9zk.pages.dev/api/analyze
